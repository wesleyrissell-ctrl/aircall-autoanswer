{
  "manifest_version": 3,
  "name": "Aircall Inbound Auto-Answer",
  "version": "0.1.2",
  "description": "Auto-answers inbound calls in the Aircall web phone after a short delay and beep.",
  "key": "",
  "update_url": "https://wesleyrissell-ctrl.github.io/aircall-autoanswer/updates.xml",
  "permissions": ["storage"],
  "host_permissions": ["https://workspace.aircall.io/*", "https://phone.aircall.io/*"],
  "content_scripts": [
    {
      "matches": ["https://workspace.aircall.io/*", "https://phone.aircall.io/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Aircall Auto-Answer",
    "default_popup": "popup.html"
  }
}
